# Настройки выкладки. Этот файл в .gitignore — адрес сервера
# в репозиторий не уезжает.

# IP или домен сервера
SSH_HOST=

# Пользователь для подключения по SSH.
# На свежем VDS обычно root. Если у вас другой — впишите его.
SSH_USER=root

# Порт SSH, если не стандартный
SSH_PORT=22

# Подпуть, по которому открывается сайт
SITE_PATH=/igrai2

# Куда класть файлы на сервере.
# Оставьте пустым — скрипт сам спросит у nginx, где корень сайта,
# и положит папку внутрь него. Заполняйте, только если хотите
# переопределить вручную, например: REMOTE_DIR=/var/www/igrai/igrai2
REMOTE_DIR=
